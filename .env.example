
# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API
# Only a client-side publishable key or legacy anon key belongs here.
# NEVER put the service_role key or a secret key in this app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
