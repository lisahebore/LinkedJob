{
  "name": "linkedjob",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npx expo install --check",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
